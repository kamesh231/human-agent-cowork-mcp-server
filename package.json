{
  "name": "@cowork/mcp-server",
  "version": "0.1.0",
  "description": "COWORK Protocol MCP Server — Human-Agent Collaboration Primitives",
  "type": "module",
  "bin": {
    "cowork-mcp": "./build/index.js",
    "cowork-sentry": "./build/sentry/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/sentry/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:sentry": "npx @modelcontextprotocol/inspector node build/sentry/index.js -- npx -y @modelcontextprotocol/server-filesystem ./",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "files": [
    "build",
    "cowork.config.yaml"
  ],
  "keywords": [
    "mcp",
    "cowork",
    "human-agent-collaboration",
    "ai-agents",
    "trust",
    "handoff",
    "protocol"
  ],
  "author": "Kamesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamesh231/human-agent-cowork-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^12.8.0",
    "yaml": "^2.7.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.8.3"
  }
}
